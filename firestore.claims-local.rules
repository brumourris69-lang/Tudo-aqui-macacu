rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Account-only resources must not be unlocked by an anonymous search session.
    function signedIn() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    // Unified prelaunch policy. Local source only; deployment requires authorization.
    function admin() {
      return signedIn() && request.auth.token.get('admin', false) == true &&
        request.auth.token.get('adminVersion', '') is string &&
        request.auth.token.get('adminVersion', '') != '' &&
        currentAdminAuthorization();
    }
    function currentAdminAuthorization() {
      let state = get(/databases/$(database)/documents/admin_authorizations/$(request.auth.uid)).data;
      return state.enabled == true && state.pending == false &&
        state.version == request.auth.token.adminVersion;
    }
    // Only the caller's minimal capability state. No client may mutate it.
    match /admin_authorizations/{uid} {
      allow get: if signedIn() && request.auth.uid == uid &&
        request.auth.token.get('admin', false) == true;
      allow list, write: if false;
    }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function str(field, max) {
      return !request.resource.data.keys().hasAny([field]) ||
        (request.resource.data[field] is string && request.resource.data[field].size() <= max);
    }
    function boolField(field) {
      return !request.resource.data.keys().hasAny([field]) || request.resource.data[field] is bool;
    }
    function sameAuthEmail() {
      return request.resource.data.email == request.auth.token.get('email', '');
    }
    function publicCollection(collection) {
      return collection in [
        'ads', 'establishments', 'offers', 'coupons', 'alerts', 'routes',
        'polls', 'jobs', 'news', 'events', 'links',
        'utilities', 'health', 'transport', 'trash_collection', 'useful_phones',
        'pharmacy_duties', 'emergency_contacts', 'resolver_subjects', 'public_places'
      ];
    }
    function validPublicContent() {
      return str('title', 140) && str('name', 140) && str('description', 3000) &&
        str('link', 2048) && str('imageUrl', 2048) && str('iconKey', 64) &&
        str('destinationType', 32) && str('destination', 2048) &&
        boolField('published') && boolField('active') && boolField('featured');
    }
    // Lists cannot prove optional field constraints. Public lists are served by
    // the local authenticated/App Check backend with current-source validation.
    // Missing optional active/expiry keeps legacy semantics; malformed denies.
    function visibleDocument(collection) {
      return (collection == 'utilities'
          ? (resource.data.active == true && resource.data.get('published', true) == true)
          : resource.data.published == true) &&
        resource.data.get('active', true) == true &&
        (!resource.data.keys().hasAny(['expiresAt']) ||
          (resource.data.expiresAt is timestamp && resource.data.expiresAt > request.time));
    }
    function safeUserCreate(userId) {
      return isOwner(userId) &&
        request.resource.data.role == 'user' &&
        request.resource.data.keys().hasOnly(['displayName', 'email', 'photoUrl', 'role', 'createdAt', 'updatedAt']) &&
        request.resource.data.keys().hasAll(['displayName', 'email', 'photoUrl', 'role', 'createdAt', 'updatedAt']) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        sameAuthEmail() &&
        str('displayName', 120) && str('email', 180) && str('photoUrl', 2048);
    }
    function safeUserUpdate(userId) {
      return isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          resource.data.keys().hasAny(['createdAt'])
            ? ['displayName', 'email', 'photoUrl', 'updatedAt']
            : ['displayName', 'email', 'photoUrl', 'updatedAt', 'createdAt']) &&
        request.resource.data.keys().hasAll(['displayName', 'email', 'photoUrl', 'role', 'createdAt', 'updatedAt']) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.createdAt == resource.data.get('createdAt', request.time) &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt == request.time &&
        sameAuthEmail() &&
        str('displayName', 120) && str('email', 180) && str('photoUrl', 2048);
    }

    match /contact_messages/{message} {
      // Backend validates schema, derives author/date, quotas and dedup.
      allow create: if false;
      allow read, delete: if admin();
      allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
        request.resource.data.read is bool;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || admin();
      allow create: if admin() || safeUserCreate(userId);
      allow update: if admin() || safeUserUpdate(userId);
      allow delete: if admin() || isOwner(userId);

      match /favorites/{favoriteId} {
        allow read: if isOwner(userId) || admin();
        allow create, update: if false;
        allow delete: if admin();
      }

      match /devices/{deviceId} {
        allow create, update: if false;
        allow delete: if admin();
        allow read: if isOwner(userId) || admin();
      }
    }

    match /metrics/{metricId} {
      allow create: if false;
      allow read, update, delete: if admin();
    }

    match /reviews/{reviewId} {
      allow create: if false;
      allow read, delete: if admin();
      allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status in ['pending', 'approved', 'rejected'];
    }

    match /business_proposals/{proposalId} {
      allow create: if false;
      allow read, delete: if admin();
      allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status in ['pending', 'approved', 'rejected'];
    }

    match /polls/{pollId}/votes/{userId} {
      allow create, update, delete: if false;
      allow read: if admin();
    }

    // Fail closed for legacy targeted/missing-recipient documents. A public
    // listing uses the local backend; direct public gets validate visibility.
    match /notifications/{notificationId} {
      allow get: if admin() || (visibleDocument('notifications') && resource.data.targetEmail == '');
      allow list: if admin();
      allow create, update: if admin() && validPublicContent() &&
        request.resource.data.keys().hasOnly([
          'title', 'description', 'link', 'published', 'active', 'expiresAt', 'updatedAt', 'targetEmail'
        ]) &&
        request.resource.data.targetEmail == '' &&
        !request.resource.data.keys().hasAny(['targetUid']);
      allow delete: if admin();
    }

    match /private_notifications/{notificationId} {
      allow read: if admin() || (signedIn() &&
        resource.data.targetUid == request.auth.uid && resource.data.published == true);
      allow create, update: if admin() && validPublicContent() &&
        request.resource.data.keys().hasOnly([
          'title', 'description', 'link', 'published', 'updatedAt', 'targetUid'
        ]) && request.resource.data.targetUid is string &&
        request.resource.data.targetUid.size() > 0 &&
        request.resource.data.targetUid.size() <= 128 &&
        !request.resource.data.targetUid.matches('.*[/].*');
      allow delete: if admin();
    }

    match /push_queue/{notificationId} {
      allow create: if admin() &&
        request.resource.data.keys().hasOnly([
          'title', 'description', 'link', 'targetEmail', 'published',
          'updatedAt', 'status', 'createdAt', 'targetUid'
        ]) &&
        request.resource.data.status == 'queued' &&
        request.resource.data.get('targetEmail', '') == '' &&
        (!request.resource.data.keys().hasAny(['targetUid']) ||
          (request.resource.data.targetUid is string &&
           request.resource.data.targetUid.size() > 0 &&
           request.resource.data.targetUid.size() <= 128 &&
           !request.resource.data.targetUid.matches('.*[/].*'))) &&
        str('title', 120) &&
        str('description', 1000) &&
        str('link', 2048) &&
        str('targetEmail', 180) &&
        str('targetUid', 128) &&
        boolField('published');
      allow read, update, delete: if admin();
    }

    match /admin_audit_logs/{logId} {
      allow create: if admin() &&
        request.resource.data.keys().hasOnly([
          'action', 'collection', 'documentId', 'label',
          'adminUid', 'adminEmail', 'createdAt'
        ]) &&
        request.resource.data.adminUid == request.auth.uid &&
        (
          request.auth.token.email == null ||
          request.resource.data.adminEmail == request.auth.token.email
        ) &&
        str('action', 80) &&
        str('collection', 80) &&
        str('documentId', 200) &&
        str('label', 200) &&
        str('adminEmail', 180);
      allow read: if admin();
      allow update, delete: if false;
    }

    match /home_pages/{pageId} {
      allow read: if pageId == 'published' || admin();
      allow create, update, delete: if admin();
    }

    match /{collection}/{document} {
      allow get: if publicCollection(collection) && (admin() || visibleDocument(collection));
      allow list: if publicCollection(collection) && admin();
      allow create, update: if admin() && publicCollection(collection) && validPublicContent();
      allow delete: if admin() && publicCollection(collection);
    }
  }
}
