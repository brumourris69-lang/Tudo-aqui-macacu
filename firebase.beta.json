{
  "firestore": {
    "rules": "firestore.beta.rules"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "firebase.*.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/media/**",
        "headers": [
          { "key": "Cache-Control", "value": "public,max-age=31536000,immutable" },
          { "key": "X-Content-Type-Options", "value": "nosniff" }
        ]
      }
    ]
  }
}
