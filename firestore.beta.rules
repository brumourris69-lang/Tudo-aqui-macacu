rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Admin claims and this versioned record are provisioned out of band.
    // No client can grant, renew, or restore its own administrative access.
    function currentAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true &&
        request.auth.token.get('adminVersion', '') is string &&
        request.auth.token.get('adminVersion', '') != '' &&
        exists(/databases/$(database)/documents/admin_authorizations/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admin_authorizations/$(request.auth.uid)).data.enabled == true &&
        get(/databases/$(database)/documents/admin_authorizations/$(request.auth.uid)).data.pending == false &&
        get(/databases/$(database)/documents/admin_authorizations/$(request.auth.uid)).data.version == request.auth.token.adminVersion;
    }

    function owner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Legacy Functions wrote userId while direct Spark flows use uid.
    // A document is self-owned only when every present identity field agrees;
    // this prevents deleting a record carrying conflicting owners.
    function ownsPersonalRecord(data) {
      return signedIn() &&
        (data.get('uid', '') == request.auth.uid ||
          data.get('userId', '') == request.auth.uid) &&
        (!data.keys().hasAny(['uid']) || data.uid == request.auth.uid) &&
        (!data.keys().hasAny(['userId']) || data.userId == request.auth.uid);
    }

    function ownsTargetedEmail(data) {
      return signedIn() && request.auth.token.get('email', '') is string &&
        request.auth.token.get('email', '') != '' &&
        data.get('targetEmail', '') == request.auth.token.email &&
        data.get('targetUid', '') == '';
    }

    function ownsTargetedDelivery(data) {
      return signedIn() &&
        (data.get('targetUid', '') == request.auth.uid ||
          ownsTargetedEmail(data));
    }

    function validContactPhone(value) {
      return value is string && value.matches(
        '^(11|12|13|14|15|16|17|18|19|21|22|24|27|28|31|32|33|34|35|37|38|41|42|43|44|45|46|47|48|49|51|53|54|55|61|62|63|64|65|66|67|68|69|71|73|74|75|77|79|81|82|83|84|85|86|87|88|89|91|92|93|94|95|96|97|98|99)([2-5][0-9]{7}|9[0-9]{8})$'
      );
    }

    function contactQuotaContainsMessage(userId, quota) {
      let messagePath = /databases/$(database)/documents/contact_messages/$(quota.lastMessageId);
      return quota.lastMessageId is string && quota.lastMessageId.size() > 0 &&
        existsAfter(messagePath) &&
        getAfter(messagePath).data.uid == userId &&
        getAfter(messagePath).data.email == request.auth.token.get('email', '') &&
        getAfter(messagePath).data.status == 'pending' &&
        getAfter(messagePath).data.quotaPeriodStartedAt == quota.periodStartedAt &&
        getAfter(messagePath).data.createdAt == request.time;
    }

    function validContactQuota(userId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'uid', 'count', 'periodStartedAt', 'lastMessageId', 'updatedAt'
        ]) && data.keys().hasAll([
          'uid', 'count', 'periodStartedAt', 'lastMessageId', 'updatedAt'
        ]) && data.uid == userId && data.count is int &&
        data.count >= 1 && data.count <= 3 && data.periodStartedAt is timestamp &&
        data.updatedAt == request.time &&
        contactQuotaContainsMessage(userId, data);
    }

    function safeText(data, field, maxLength) {
      return !data.keys().hasAny([field]) ||
        (data[field] is string && data[field].size() <= maxLength);
    }

    function safeList(data, field, maxLength) {
      return !data.keys().hasAny([field]) ||
        (data[field] is list && data[field].size() <= maxLength);
    }

    function safeDate(data, field) {
      return !data.keys().hasAny([field]) || data[field] is timestamp ||
        (data[field] is string && data[field].size() <= 100);
    }

    function editableCollection(collectionId) {
      return collectionId in [
        'establishments', 'ads', 'offers', 'coupons', 'alerts', 'routes',
        'polls', 'news', 'events', 'links', 'utilities', 'health',
        'transport', 'trash_collection', 'useful_phones', 'pharmacy_duties',
        'emergency_contacts', 'resolver_subjects', 'public_places'
      ];
    }

    function validCatalogFields(data) {
      return data.keys().hasOnly([
          'name', 'title', 'category', 'subcategory', 'description',
          'shortDescription', 'location', 'address', 'iconKey', 'imageUrl',
          'logoUrl', 'maps', 'mapsUrl', 'phone', 'whatsapp', 'instagram',
          'type', 'employmentType', 'company', 'eventDate', 'endDate', 'date',
          'startsAt', 'startTime', 'endTime', 'organizer', 'registrationUrl',
          'contactUrl', 'link', 'destinationType', 'destination',
          'businessId',
          'promotionTitle', 'promotionDescription', 'hours', 'additionalInfo',
          'galleryUrls', 'videoUrls', 'services', 'products', 'artwork',
          'order', 'featured', 'open', 'options'
        ]) &&
        (data.keys().hasAny(['name']) || data.keys().hasAny(['title'])) &&
        safeText(data, 'name', 160) && safeText(data, 'title', 160) &&
        safeText(data, 'category', 100) &&
        safeText(data, 'description', 4000) &&
        safeText(data, 'shortDescription', 1000) &&
        safeText(data, 'businessId', 128) &&
        safeText(data, 'location', 500) && safeText(data, 'address', 500) &&
        safeText(data, 'imageUrl', 2048) && safeDate(data, 'eventDate') &&
        safeDate(data, 'endDate') && safeDate(data, 'date') &&
        safeDate(data, 'startsAt') &&
        safeList(data, 'galleryUrls', 20) && safeList(data, 'videoUrls', 20) &&
        safeList(data, 'services', 40) && safeList(data, 'products', 40) &&
        safeList(data, 'options', 20) &&
        (!data.keys().hasAny(['artwork']) ||
          (data.artwork is int && data.artwork >= 0 && data.artwork <= 100000)) &&
        (!data.keys().hasAny(['order']) ||
          (data.order is int && data.order >= 0 && data.order <= 100000)) &&
        (!data.keys().hasAny(['featured']) || data.featured is bool) &&
        (!data.keys().hasAny(['open']) || data.open is bool);
    }

    function validProjection(data, collectionId, itemId) {
      return canonicalIsPublic(collectionId, itemId) &&
        validProjectionShape(data, collectionId, itemId);
    }

    function validEstablishmentProjectionForRead(data, itemId) {
      let sourcePath = /databases/$(database)/documents/establishments/$(itemId);
      let source = get(sourcePath).data;
      return source is map &&
        (!source.keys().hasAny(['published']) || source.published != false) &&
        (!source.keys().hasAny(['active']) || source.active != false) &&
        (!source.keys().hasAny(['deleted']) || source.deleted != true) &&
        (!source.keys().hasAny(['deletedAt']) || source.deletedAt == null) &&
        validBasicEstablishmentProjection(data, itemId);
    }

    function validBasicEstablishmentData(data) {
      return data.keys().hasOnly([
          'name', 'title', 'address', 'location', 'phone', 'category',
          'subcategory', 'order'
        ]) && (data.keys().hasAny(['name']) || data.keys().hasAny(['title'])) &&
        safeText(data, 'name', 160) && safeText(data, 'title', 160) &&
        safeText(data, 'address', 500) && safeText(data, 'location', 500) &&
        safeText(data, 'phone', 80) && safeText(data, 'category', 100) &&
        safeText(data, 'subcategory', 100) &&
        (!data.keys().hasAny(['order']) ||
          (data.order is int && data.order >= 0 && data.order <= 100000));
    }

    function validBasicEstablishmentProjection(data, itemId) {
      return data is map && data.keys().hasOnly([
          'visibility', 'sourceId', 'schemaVersion', 'updatedAt', 'publicData'
        ]) && data.keys().hasAll([
          'visibility', 'sourceId', 'schemaVersion', 'updatedAt', 'publicData'
        ]) && data.visibility == 'public' && data.sourceId == itemId &&
        data.schemaVersion == 1 && data.updatedAt is timestamp &&
        data.publicData is map && validBasicEstablishmentData(data.publicData);
    }

    function validProjectionShape(data, collectionId, itemId) {
      return editableCollection(collectionId) &&
        data.keys().hasOnly([
          'visibility', 'sourceId', 'schemaVersion', 'updatedAt', 'publicData'
        ]) &&
        data.keys().hasAll([
          'visibility', 'sourceId', 'schemaVersion', 'updatedAt', 'publicData'
        ]) &&
        data.visibility == 'public' && data.sourceId == itemId &&
        data.schemaVersion == 1 && data.updatedAt is timestamp &&
        data.publicData is map &&
        (collectionId == 'establishments'
          ? validBasicEstablishmentData(data.publicData)
          : validCatalogFields(data.publicData)) &&
        (data.publicData.keys().hasAny(['businessId']) ==
          (collectionId == 'ads')) &&
        (collectionId != 'ads' || validAdBusinessTarget(data.publicData));
    }

    function validAdBusinessTarget(data) {
      let businessId = data.get('businessId', '');
      let businessPath = /databases/$(database)/documents/establishments/$(businessId);
      let business = getAfter(businessPath).data;
      return businessId is string && businessId.size() > 0 &&
        businessId.size() <= 128 && !businessId.matches('.*[/].*') &&
        businessId != '.' && businessId != '..' &&
        existsAfter(businessPath) && business is map &&
        (!business.keys().hasAny(['published']) || business.published == true) &&
        (!business.keys().hasAny(['active']) || business.active == true) &&
        (!business.keys().hasAny(['deleted']) || business.deleted == false) &&
        (!business.keys().hasAny(['deletedAt']) || business.deletedAt == null);
    }

    function canonicalIsPublic(collectionId, itemId) {
      let sourcePath = /databases/$(database)/documents/$(collectionId)/$(itemId);
      let source = getAfter(sourcePath).data;
      return source is map &&
        (!source.keys().hasAny(['published']) || source.published != false) &&
        (!source.keys().hasAny(['active']) || source.active != false) &&
        (!source.keys().hasAny(['deleted']) || source.deleted != true) &&
        (!source.keys().hasAny(['deletedAt']) || source.deletedAt == null);
    }

    function premiumEntitlementIsActive(source) {
      return source is map && source.published == true &&
        source.active == true &&
        (!source.keys().hasAny(['deleted']) || source.deleted == false) &&
        (!source.keys().hasAny(['deletedAt']) || source.deletedAt == null) &&
        source.get('listingTier', 'basic') == 'premium' &&
        source.get('premiumUntil', null) is timestamp &&
        source.premiumUntil > request.time;
    }

    function validPremiumProjectionData(data, itemId, source) {
      return data is map && data.keys().hasOnly([
          'visibility', 'sourceId', 'schemaVersion', 'updatedAt',
          'listingTier', 'premiumUntil', 'publicData'
        ]) && data.keys().hasAll([
          'visibility', 'sourceId', 'schemaVersion', 'updatedAt',
          'listingTier', 'premiumUntil', 'publicData'
        ]) && data.visibility == 'public' && data.sourceId == itemId &&
        data.schemaVersion == 1 && data.updatedAt is timestamp &&
        data.listingTier == 'premium' && data.premiumUntil is timestamp &&
        data.premiumUntil == source.premiumUntil &&
        data.publicData is map && validPremiumEstablishmentData(data.publicData);
    }

    function validPremiumEstablishmentData(data) {
      return data.keys().hasOnly([
          'description', 'shortDescription', 'iconKey', 'imageUrl',
          'logoUrl', 'maps', 'mapsUrl', 'whatsapp', 'instagram', 'type',
          'contactUrl', 'link', 'hours', 'additionalInfo', 'galleryUrls',
          'videoUrls', 'services', 'products', 'artwork', 'featured', 'open',
          'options'
        ]) &&
        safeText(data, 'description', 4000) &&
        safeText(data, 'shortDescription', 1000) &&
        safeText(data, 'iconKey', 80) && safeText(data, 'imageUrl', 2048) &&
        safeText(data, 'logoUrl', 2048) && safeText(data, 'maps', 2048) &&
        safeText(data, 'mapsUrl', 2048) && safeText(data, 'whatsapp', 160) &&
        safeText(data, 'instagram', 300) && safeText(data, 'type', 100) &&
        safeText(data, 'contactUrl', 2048) && safeText(data, 'link', 2048) &&
        safeText(data, 'hours', 500) && safeText(data, 'additionalInfo', 2000) &&
        safeList(data, 'galleryUrls', 20) && safeList(data, 'videoUrls', 20) &&
        safeList(data, 'services', 40) && safeList(data, 'products', 40) &&
        safeList(data, 'options', 20) &&
        (!data.keys().hasAny(['artwork']) ||
          (data.artwork is int && data.artwork >= 0 && data.artwork <= 100000)) &&
        (!data.keys().hasAny(['featured']) || data.featured is bool) &&
        (!data.keys().hasAny(['open']) || data.open is bool);
    }

    function premiumProjectionIsReadable(data, itemId) {
      let sourcePath = /databases/$(database)/documents/establishments/$(itemId);
      let basicPath = /databases/$(database)/documents/beta_public_catalog/establishments_basic/items/$(itemId);
      let source = get(sourcePath).data;
      let basic = get(basicPath).data;
      return exists(sourcePath) && premiumEntitlementIsActive(source) &&
        exists(basicPath) && validBasicEstablishmentProjection(basic, itemId) &&
        validPremiumProjectionData(data, itemId, source);
    }

    function premiumProjectionIsSynchronized(itemId) {
      let sourcePath = /databases/$(database)/documents/establishments/$(itemId);
      let premiumPath = /databases/$(database)/documents/beta_public_catalog/establishments_premium/items/$(itemId);
      let source = getAfter(sourcePath).data;
      let premiumExists = existsAfter(premiumPath);
      let premium = getAfter(premiumPath).data;
      return premiumEntitlementIsActive(source)
        ? premiumExists && premium is map &&
          premium.visibility == 'public' && premium.sourceId == itemId &&
          premium.schemaVersion == 1 && premium.listingTier == 'premium' &&
          premium.premiumUntil == source.premiumUntil &&
          premium.updatedAt == request.time
        : !premiumExists;
    }

    function notTombstoned() {
      return (!resource.data.keys().hasAny(['deleted']) ||
          resource.data.deleted != true) &&
        (!resource.data.keys().hasAny(['deletedAt']) ||
          resource.data.deletedAt == null);
    }

    function projectionIsSynchronized(collectionId, itemId) {
      let projectionCollection = collectionId == 'establishments'
        ? 'establishments_basic' : collectionId;
      let projectionPath = /databases/$(database)/documents/beta_public_catalog/$(projectionCollection)/items/$(itemId);
      let sourceIsPublic = canonicalIsPublic(collectionId, itemId);
      let projectionExists = existsAfter(projectionPath);
      let projection = projectionExists ? getAfter(projectionPath).data : null;
      let synchronizedPublic = (sourceIsPublic && projectionExists &&
          (collectionId == 'establishments'
            ? validBasicEstablishmentProjection(projection, itemId) &&
              projection.updatedAt == request.time
            : projection is map && projection.sourceId == itemId &&
              projection.updatedAt == request.time)) ||
        (!sourceIsPublic && !projectionExists);
      return collectionId == 'establishments'
        ? synchronizedPublic && premiumProjectionIsSynchronized(itemId)
        : synchronizedPublic;
    }

    function validProfile(userId) {
      return owner(userId) && request.resource.data.role == 'user' &&
        request.resource.data.keys().hasOnly([
          'displayName', 'email', 'photoUrl', 'role', 'createdAt', 'updatedAt'
        ]) && request.resource.data.email == request.auth.token.get('email', '') &&
        safeText(request.resource.data, 'displayName', 120) &&
        safeText(request.resource.data, 'email', 180) &&
        safeText(request.resource.data, 'photoUrl', 2048);
    }

    function validFavorite(favoriteId) {
      return request.resource.data.keys().hasOnly([
          'id', 'name', 'type', 'targetId', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'id', 'name', 'type', 'targetId', 'createdAt'
        ]) && request.resource.data.id == favoriteId &&
        request.resource.data.id is string && request.resource.data.id.size() > 0 &&
        request.resource.data.id.size() <= 200 &&
        !request.resource.data.id.matches('.*[/].*') &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 160 &&
        request.resource.data.type in ['business', 'tourism', 'event'] &&
        request.resource.data.targetId is string &&
        request.resource.data.targetId.size() > 0 &&
        request.resource.data.targetId.size() <= 128 &&
        !request.resource.data.targetId.matches('.*[/].*') &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp;
    }

    match /admin_authorizations/{uid} {
      allow get: if signedIn() && request.auth.uid == uid &&
        request.auth.token.get('admin', false) == true;
      allow list, create, update, delete: if false;
    }

    match /{collectionId}/{itemId} {
      allow get, list: if currentAdmin() && editableCollection(collectionId);
      allow create: if currentAdmin() && editableCollection(collectionId) &&
        projectionIsSynchronized(collectionId, itemId);
      allow update: if currentAdmin() && editableCollection(collectionId) &&
        notTombstoned() &&
        projectionIsSynchronized(collectionId, itemId);
      // Content deletion is logical. Keep the canonical tombstone permanently.
      allow delete: if false;
    }

    match /job_private/{jobId} {
      // Job listings are deferred from the public MVP. Keep existing private
      // records inspectable by an authorized Admin, but freeze client writes.
      allow get: if currentAdmin();
      allow list: if currentAdmin() && request.query.limit != null &&
        request.query.limit <= 30;
      allow create, update, delete: if false;
    }

    match /home_pages/{pageId} {
      allow get: if currentAdmin() || (pageId == 'published' &&
        (!exists(/databases/$(database)/documents/home_pages/published) ||
          (resource.data.published == true && resource.data.active == true)));
      allow list: if currentAdmin();
      allow create, update, delete: if currentAdmin();
    }

    match /admin_audit_logs/{logId} {
      allow read: if currentAdmin();
      allow create: if currentAdmin() &&
        request.resource.data.keys().hasOnly([
          'action', 'collection', 'documentId', 'label', 'adminUid',
          'adminEmail', 'createdAt'
        ]) && request.resource.data.adminUid == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        safeText(request.resource.data, 'action', 80) &&
        safeText(request.resource.data, 'collection', 100) &&
        safeText(request.resource.data, 'documentId', 200) &&
        safeText(request.resource.data, 'label', 200) &&
        safeText(request.resource.data, 'adminEmail', 180);
      allow update, delete: if false;
    }

    match /contact_messages/{messageId} {
      allow get: if currentAdmin();
      allow list: if currentAdmin() || (ownsPersonalRecord(resource.data) &&
        request.query.limit != null && request.query.limit <= 100);
      allow create: if signedIn() &&
        !exists(/databases/$(database)/documents/account_deletion_requests/$(request.auth.uid)) &&
        request.resource.data.keys().hasOnly([
          'uid', 'email', 'contact', 'message', 'status', 'createdAt',
          'quotaPeriodStartedAt'
        ]) && request.resource.data.keys().hasAll([
          'uid', 'email', 'contact', 'message', 'status', 'createdAt',
          'quotaPeriodStartedAt'
        ]) && request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.get('email', '') &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0 &&
        validContactPhone(request.resource.data.contact) &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.message.size() <= 2000 &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.quotaPeriodStartedAt is timestamp &&
        existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/contact_message_limits/current) &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/contact_message_limits/current).data.lastMessageId == messageId &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/contact_message_limits/current).data.uid == request.auth.uid &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/contact_message_limits/current).data.count <= 3 &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/contact_message_limits/current).data.updatedAt == request.time &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/contact_message_limits/current).data.periodStartedAt == request.resource.data.quotaPeriodStartedAt;
      allow update: if false;
      allow delete: if ownsPersonalRecord(resource.data);
    }

    match /business_proposals/{proposalId} {
      allow get: if currentAdmin();
      allow list: if currentAdmin() || (ownsPersonalRecord(resource.data) &&
        request.query.limit != null && request.query.limit <= 100);
      // Proposals are deferred from the public MVP. Historical records remain
      // owner-readable/deletable, but clients cannot create new requests.
      allow create: if false;
      allow update: if false;
      allow delete: if ownsPersonalRecord(resource.data);
    }

    match /reviews/{reviewId} {
      allow get: if currentAdmin();
      allow list: if currentAdmin() || (ownsPersonalRecord(resource.data) &&
        request.query.limit != null && request.query.limit <= 100);
      // Reviews are deferred from the public MVP. A stale client route must
      // not bypass the closed feature switch by writing directly to Firestore.
      allow create: if false;
      allow update: if currentAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'published', 'updatedAt'
        ]);
      allow delete: if currentAdmin() || ownsPersonalRecord(resource.data);
    }

    // Metrics created by the former callable are keyed by userId. The owner
    // may enumerate a bounded page for account deletion, but cannot write.
    match /metrics/{metricId} {
      allow list: if ownsPersonalRecord(resource.data) &&
        request.query.limit != null && request.query.limit <= 100;
      allow delete: if ownsPersonalRecord(resource.data);
    }

    // Legacy email-addressed notifications are private to the signed-in
    // account whose current Firebase Auth email matches the stored recipient.
    match /notifications/{notificationId} {
      allow get: if ownsTargetedEmail(resource.data);
      allow list: if ownsTargetedEmail(resource.data) &&
        request.query.limit != null && request.query.limit <= 100;
      allow create, update: if false;
      allow delete: if ownsTargetedEmail(resource.data);
    }

    // A recipient may read and remove only private notifications addressed to
    // their own stable Firebase UID. Creation remains Admin-only.
    match /private_notifications/{notificationId} {
      allow get: if currentAdmin() || owner(resource.data.targetUid);
      allow list: if currentAdmin() ||
        (owner(resource.data.targetUid) && request.query.limit != null &&
          request.query.limit <= 100);
      allow create, update: if false;
      allow delete: if currentAdmin() || owner(resource.data.targetUid);
    }

    // The push queue is private delivery state. Its recipient can enumerate
    // and remove only their own UID-addressed items; writes remain Admin-only.
    match /push_queue/{queueId} {
      allow get: if currentAdmin() || ownsTargetedDelivery(resource.data);
      allow list: if currentAdmin() ||
        (ownsTargetedDelivery(resource.data) && request.query.limit != null &&
          request.query.limit <= 100);
      allow create, update: if false;
      allow delete: if currentAdmin() || ownsTargetedDelivery(resource.data);
    }

    match /polls/{pollId}/votes/{userId} {
      function publicPollHasOption(option) {
        let poll = get(/databases/$(database)/documents/beta_public_catalog/polls/items/$(pollId)).data;
        return poll.visibility == 'public' && poll.publicData.options is list &&
          poll.publicData.options.size() <= 20 && option in poll.publicData.options;
      }
      allow get: if currentAdmin() || owner(userId);
      // Collection-group cleanup is limited and can only return records whose
      // immutable UID field is the caller. It reveals no other user's votes.
      allow list: if currentAdmin() || (signedIn() &&
        resource.data.uid == request.auth.uid &&
        request.query.limit != null && request.query.limit <= 100);
      // Voting is deferred from public MVP 1.0; retain cleanup access only.
      allow create: if false;
      allow update: if false;
      allow delete: if owner(userId) &&
        (!resource.data.keys().hasAny(['uid']) ||
          resource.data.uid == request.auth.uid);
    }

    // Firestore collection-group queries require a recursive match. This
    // grants only bounded listing of vote documents carrying the caller UID;
    // direct reads/deletes still use the more specific poll-vote rule above.
    match /{path=**}/votes/{voteId} {
      allow list: if signedIn() &&
        resource.data.uid == request.auth.uid &&
        request.query.limit != null && request.query.limit <= 100;
    }

    match /beta_public_catalog/{collectionId}/items/{itemId} {
      // `establishments` is the legacy wide projection. Do not expose old
      // documents, which may contain fields that were Premium before the split.
      allow get, list: if collectionId == 'establishments' && currentAdmin();
      // Firestore Rules are not filters. The trusted editor only creates
      // allowlisted projections; clients must query the public marker and cap
      // every page so this rule can prove the query is safe.
      allow get: if collectionId != 'establishments' &&
        collectionId != 'establishments_premium' &&
        collectionId != 'establishments_basic' &&
        (currentAdmin() || validProjection(resource.data, collectionId, itemId));
      allow list: if collectionId != 'establishments' &&
        collectionId != 'establishments_premium' &&
        collectionId != 'establishments_basic' &&
        editableCollection(collectionId) &&
        resource.data.visibility == 'public' &&
        request.query.limit != null && request.query.limit <= 40;
      allow create, update: if collectionId != 'establishments' &&
        collectionId != 'establishments_premium' &&
        collectionId != 'establishments_basic' &&
        currentAdmin() &&
        validProjection(request.resource.data, collectionId, itemId);
      allow delete: if collectionId != 'establishments' &&
        collectionId != 'establishments_premium' &&
        collectionId != 'establishments_basic' && currentAdmin();
    }

    match /beta_public_catalog/establishments_basic/items/{itemId} {
      allow get: if currentAdmin() ||
        validEstablishmentProjectionForRead(resource.data, itemId);
      // Basic documents are written only by the Admin's atomic canonical
      // publication transaction. Query authorization can then be proven from
      // the public marker and bounded page size without exposing rich fields.
      allow list: if resource.data.visibility == 'public' &&
        request.query.limit != null && request.query.limit <= 40;
      allow create, update: if currentAdmin() &&
        validBasicEstablishmentProjection(request.resource.data, itemId) &&
        canonicalIsPublic('establishments', itemId);
      allow delete: if currentAdmin() &&
        !canonicalIsPublic('establishments', itemId);
    }

    match /beta_public_catalog/establishments_premium/items/{itemId} {
      allow get: if !exists(/databases/$(database)/documents/beta_public_catalog/establishments_premium/items/$(itemId)) ||
        premiumProjectionIsReadable(resource.data, itemId);
      // Queries are evaluated per returned record, so expired or stale records
      // fail the whole query rather than being silently filtered by Rules.
      allow list: if request.query.limit != null && request.query.limit <= 40 &&
        premiumProjectionIsReadable(resource.data, itemId);
      allow create, update: if currentAdmin() &&
        validPremiumProjectionData(
          request.resource.data,
          itemId,
          getAfter(/databases/$(database)/documents/establishments/$(itemId)).data
        ) &&
        premiumEntitlementIsActive(
          getAfter(/databases/$(database)/documents/establishments/$(itemId)).data
        ) &&
        existsAfter(/databases/$(database)/documents/beta_public_catalog/establishments_basic/items/$(itemId));
      allow delete: if currentAdmin() &&
        !premiumEntitlementIsActive(
          getAfter(/databases/$(database)/documents/establishments/$(itemId)).data
        );
    }

    // A quota-blocked account deletion is durably recorded for manual review.
    // Only the owner may create/read its own request; authorized Admins may
    // inspect a bounded queue. Requests cannot be edited or discarded early.
    match /account_deletion_requests/{userId} {
      allow get: if currentAdmin() || owner(userId);
      allow list: if currentAdmin() && request.query.limit != null &&
        request.query.limit <= 100;
      allow create: if owner(userId) &&
        request.auth.token.get('admin', false) != true && !currentAdmin() &&
        exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.role == 'user' &&
        exists(/databases/$(database)/documents/users/$(userId)/contact_message_limits/current) &&
        get(/databases/$(database)/documents/users/$(userId)/contact_message_limits/current).data.uid == userId &&
        get(/databases/$(database)/documents/users/$(userId)/contact_message_limits/current).data.periodStartedAt is timestamp &&
        request.time < get(/databases/$(database)/documents/users/$(userId)/contact_message_limits/current).data.periodStartedAt + duration.value(24, 'h') &&
        request.resource.data.keys().hasOnly([
          'uid', 'requestedAt', 'retryAfter', 'status'
        ]) && request.resource.data.keys().hasAll([
          'uid', 'requestedAt', 'retryAfter', 'status'
        ]) && request.resource.data.uid == userId &&
        request.resource.data.requestedAt == request.time &&
        request.resource.data.retryAfter ==
          get(/databases/$(database)/documents/users/$(userId)/contact_message_limits/current).data.periodStartedAt + duration.value(24, 'h') &&
        request.resource.data.status == 'pending';
      allow update: if false;
      allow delete: if owner(userId) && resource.data.uid == userId &&
        resource.data.status == 'pending' &&
        resource.data.retryAfter is timestamp &&
        request.time >= resource.data.retryAfter &&
        exists(/databases/$(database)/documents/users/$(userId)) &&
        !existsAfter(/databases/$(database)/documents/users/$(userId)) &&
        !existsAfter(/databases/$(database)/documents/users/$(userId)/contact_message_limits/current);
    }

    match /users/{userId} {
      allow get: if owner(userId);
      allow list: if false;
      allow create: if validProfile(userId) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if owner(userId) && resource.data.role == 'user' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'email', 'photoUrl', 'updatedAt'
        ]) && request.resource.data.role == resource.data.role &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.email == request.auth.token.get('email', '') &&
        safeText(request.resource.data, 'displayName', 120) &&
        safeText(request.resource.data, 'email', 180) &&
        safeText(request.resource.data, 'photoUrl', 2048);
      allow delete: if owner(userId) &&
        resource.data.role == 'user' &&
        request.auth.token.get('admin', false) != true;

      match /favorites/{favoriteId} {
        allow get, list: if owner(userId);
        allow create: if owner(userId) && validFavorite(favoriteId) &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.updatedAt == request.time;
        allow update: if owner(userId) && validFavorite(favoriteId) &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.updatedAt == request.time;
        allow delete: if owner(userId);
      }

      // Device tokens are sensitive personal data. A user can only enumerate
      // and delete tokens below their own UID; registration remains trusted.
      match /devices/{deviceId} {
        allow get: if owner(userId);
        allow list: if owner(userId) && request.query.limit != null &&
          request.query.limit <= 100;
        allow delete: if owner(userId);
      }

      match /contact_message_limits/{limitId} {
        allow get: if owner(userId) && limitId == 'current';
        allow list: if false;
        allow delete: if owner(userId) && limitId == 'current' &&
          resource.data.uid == userId &&
          resource.data.periodStartedAt is timestamp &&
          request.time >= resource.data.periodStartedAt + duration.value(24, 'h');
        allow create: if owner(userId) && limitId == 'current' &&
          validContactQuota(userId) && request.resource.data.count == 1 &&
          request.resource.data.periodStartedAt == request.time;
        allow update: if owner(userId) && limitId == 'current' &&
          validContactQuota(userId) && resource.data.uid == userId &&
          resource.data.count is int && resource.data.count >= 1 &&
          resource.data.count <= 3 && resource.data.periodStartedAt is timestamp &&
          ((request.time < resource.data.periodStartedAt + duration.value(24, 'h') &&
              resource.data.count < 3 &&
              request.resource.data.count == resource.data.count + 1 &&
              request.resource.data.periodStartedAt == resource.data.periodStartedAt) ||
            (request.time >= resource.data.periodStartedAt + duration.value(24, 'h') &&
              request.resource.data.count == 1 &&
              request.resource.data.periodStartedAt == request.time));
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
