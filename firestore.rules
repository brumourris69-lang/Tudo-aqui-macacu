rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && request.auth.token.email == 'bru.mourris69@gmail.com';
    }

    match /contact_messages/{message} {
      allow create: if signedIn();
      allow read, update, delete: if admin();
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || admin());
      allow create: if admin() || (signedIn() && request.auth.uid == userId && request.resource.data.role == 'user');
      allow update: if admin() || (signedIn() && request.auth.uid == userId && request.resource.data.role == resource.data.role);
      allow delete: if admin() || (signedIn() && request.auth.uid == userId);

      match /favorites/{favoriteId} {
        allow read, write: if signedIn() && (request.auth.uid == userId || admin());
      }
    }

    match /{collection}/{document} {
      allow read: if collection in ['ads', 'establishments', 'offers', 'jobs', 'news', 'events', 'links'] && (signedIn() || resource.data.published == true);
      allow create, update, delete: if admin();
    }
  }
}
