rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && request.auth.token.email == 'bru.mourris69@gmail.com';
    }

    match /contact_messages/{message} {
      allow create: if signedIn();
      allow read, update, delete: if admin();
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || admin());
      allow create: if admin() || (signedIn() && request.auth.uid == userId && request.resource.data.role == 'user');
      allow update: if admin() || (signedIn() && request.auth.uid == userId && request.resource.data.role == resource.data.role);
      allow delete: if admin() || (signedIn() && request.auth.uid == userId);

      match /favorites/{favoriteId} {
        allow read, write: if signedIn() && (request.auth.uid == userId || admin());
      }

      match /devices/{deviceId} {
        allow create, update, delete: if signedIn() && request.auth.uid == userId;
        allow read: if signedIn() && (request.auth.uid == userId || admin());
      }
    }

    match /metrics/{metricId} {
      allow create: if signedIn();
      allow read, update, delete: if admin();
    }

    match /reviews/{reviewId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'pending';
      allow read, update, delete: if admin();
    }

    match /business_proposals/{proposalId} {
      allow create: if signedIn();
      allow read, update, delete: if admin();
    }

    match /polls/{pollId}/votes/{userId} {
      allow create, update, delete: if signedIn() && request.auth.uid == userId;
      allow read: if admin();
    }

    match /push_queue/{notificationId} {
      allow create, read, update, delete: if admin();
    }

    match /admin_audit_logs/{logId} {
      allow create, read: if admin();
      allow update, delete: if false;
    }
    match /home_pages/{pageId} {
      allow read: if pageId == 'published' || admin();
      allow create, update, delete: if admin();
    }

    match /{collection}/{document} {
      allow read: if collection in ['ads', 'establishments', 'offers', 'coupons', 'alerts', 'routes', 'polls', 'jobs', 'news', 'events', 'links', 'notifications'] && (signedIn() || resource.data.published == true);
      allow create, update, delete: if admin();
    }
  }
}
