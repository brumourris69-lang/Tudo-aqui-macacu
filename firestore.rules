rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Account-only resources must not be unlocked by an anonymous search session.
    function signedIn() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    // Unified prelaunch policy. Local source only; deployment requires authorization.
    function admin() {
      return signedIn() && request.auth.token.get('admin', false) == true &&
        request.auth.token.get('adminVersion', '') is string &&
        request.auth.token.get('adminVersion', '') != '' &&
        currentAdminAuthorization();
    }
    function currentAdminAuthorization() {
      let state = get(/databases/$(database)/documents/admin_authorizations/$(request.auth.uid)).data;
      return state.enabled == true && state.pending == false &&
        state.version == request.auth.token.adminVersion;
    }
    // Only the caller's minimal capability state. No client may mutate it.
    match /admin_authorizations/{uid} {
      allow get: if signedIn() && request.auth.uid == uid &&
        request.auth.token.get('admin', false) == true;
      allow list, write: if false;
    }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function validFavorite(favoriteId) {
      return request.resource.data.keys().hasOnly([
          'id', 'name', 'type', 'targetId', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'id', 'name', 'type', 'targetId', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.id == favoriteId &&
        request.resource.data.id is string &&
        request.resource.data.id.size() > 0 &&
        request.resource.data.id.size() <= 200 &&
        !request.resource.data.id.matches('.*[/].*') &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 160 &&
        request.resource.data.type in ['business', 'tourism', 'event'] &&
        request.resource.data.targetId is string &&
        request.resource.data.targetId.size() > 0 &&
        request.resource.data.targetId.size() <= 128 &&
        !request.resource.data.targetId.matches('.*[/].*') &&
        favoriteId == request.resource.data.type + '::' + request.resource.data.targetId;
    }
    function str(field, max) {
      return !request.resource.data.keys().hasAny([field]) ||
        (request.resource.data[field] is string && request.resource.data[field].size() <= max);
    }
    function boolField(field) {
      return !request.resource.data.keys().hasAny([field]) || request.resource.data[field] is bool;
    }
    function sameAuthEmail() {
      return request.resource.data.email == request.auth.token.get('email', '');
    }
    function publicCollection(collection) {
      return collection in [
        'ads', 'establishments', 'offers', 'coupons', 'alerts', 'routes',
        'polls', 'jobs', 'news', 'events', 'links',
        'utilities', 'health', 'transport', 'trash_collection', 'useful_phones',
        'pharmacy_duties', 'emergency_contacts', 'resolver_subjects', 'public_places'
      ];
    }
    function validPublicContent() {
      return str('title', 140) && str('name', 140) && str('description', 3000) &&
        str('link', 2048) && str('imageUrl', 2048) && str('iconKey', 64) &&
        str('businessId', 128) &&
        str('destinationType', 32) && str('destination', 2048) &&
        boolField('published') && boolField('active') && boolField('featured');
    }
    function validAdBusinessDestination(collection) {
      let businessId = request.resource.data.get('businessId', '');
      let businessPath = /databases/$(database)/documents/establishments/$(businessId);
      let business = get(businessPath).data;
      return collection != 'ads' ||
        (request.resource.data.get('published', true) != true ||
          request.resource.data.get('active', true) != true ||
          (businessId is string && businessId.size() > 0 &&
           businessId.size() <= 128 && !businessId.matches('.*[/].*') &&
           businessId != '.' && businessId != '..' &&
           exists(businessPath) && business is map &&
           (!business.keys().hasAny(['published']) || business.published == true) &&
           (!business.keys().hasAny(['active']) || business.active == true) &&
           (!business.keys().hasAny(['deleted']) || business.deleted == false) &&
           (!business.keys().hasAny(['deletedAt']) || business.deletedAt == null)));
    }
    // Lists cannot prove optional field constraints. Public lists are served by
    // the local authenticated/App Check backend with current-source validation.
    // Missing optional active/expiry keeps legacy semantics; malformed denies.
    function visibleDocument(collection) {
      return (collection == 'events'
          ? (resource.data.published == true && resource.data.active == true)
          : collection == 'utilities'
          ? (resource.data.active == true && resource.data.get('published', true) == true)
          : resource.data.published == true) &&
        resource.data.get('active', true) == true &&
        resource.data.get('deleted', false) == false &&
        !resource.data.keys().hasAny(['deletedAt']) &&
        (!resource.data.keys().hasAny(['expiresAt']) ||
          (resource.data.expiresAt is timestamp && resource.data.expiresAt > request.time));
    }
    function visibleCanonicalSource(collection, itemId) {
      let sourcePath = /databases/$(database)/documents/$(collection)/$(itemId);
      let source = get(sourcePath).data;
      return exists(sourcePath) && source is map &&
        (collection == 'events'
          ? source.get('published', false) == true && source.get('active', false) == true
          : collection == 'utilities'
          ? source.get('active', false) == true && source.get('published', true) == true
          : source.get('published', true) == true) &&
        source.get('active', true) == true &&
        source.get('deleted', false) == false &&
        (!source.keys().hasAny(['deletedAt']) || source.deletedAt == null) &&
        (!source.keys().hasAny(['expiresAt']) ||
          (source.expiresAt is timestamp && source.expiresAt > request.time));
    }
    function visibleCanonicalAfter(collection, itemId) {
      let sourcePath = /databases/$(database)/documents/$(collection)/$(itemId);
      let source = getAfter(sourcePath).data;
      return existsAfter(sourcePath) && source is map &&
        source.get('updatedAt', null) == request.time &&
        (collection == 'events'
          ? source.get('published', false) == true && source.get('active', false) == true
          : collection == 'utilities'
          ? source.get('active', false) == true && source.get('published', true) == true
          : source.get('published', true) == true) &&
        source.get('active', true) == true &&
        source.get('deleted', false) == false &&
        (!source.keys().hasAny(['deletedAt']) || source.deletedAt == null) &&
        (!source.keys().hasAny(['expiresAt']) ||
          (source.expiresAt is timestamp && source.expiresAt > request.time));
    }
    function canonicalAfterIsUnavailable(collection, itemId) {
      let sourcePath = /databases/$(database)/documents/$(collection)/$(itemId);
      let source = getAfter(sourcePath).data;
      return !existsAfter(sourcePath) || source is map &&
        source.get('updatedAt', null) == request.time &&
        (source.get('published', true) == false || source.get('active', true) == false ||
          source.get('deleted', false) == true ||
          (source.keys().hasAny(['deletedAt']) && source.deletedAt != null));
    }
    function basicProjectionAfterMatches(itemId) {
      let projectionPath = /databases/$(database)/documents/beta_public_catalog/establishments_basic/items/$(itemId);
      let projection = getAfter(projectionPath).data;
      return existsAfter(projectionPath) &&
        projection is map && projection.visibility == 'public' &&
        projection.sourceId == itemId && projection.updatedAt == request.time;
    }
    function canonicalAfterIsVisibleBasic(itemId) {
      let sourcePath = /databases/$(database)/documents/establishments/$(itemId);
      let source = getAfter(sourcePath).data;
      return existsAfter(sourcePath) && source is map &&
        source.get('updatedAt', null) == request.time &&
        source.get('published', false) == true &&
        source.get('active', false) == true &&
        source.get('deleted', false) == false &&
        (!source.keys().hasAny(['deletedAt']) || source.deletedAt == null) &&
        (!source.keys().hasAny(['expiresAt']) ||
          (source.expiresAt is timestamp && source.expiresAt > request.time)) &&
        !premiumEntitlementIsCurrent(source) &&
        basicProjectionAfterMatches(itemId) &&
        validBasicProjectionEnvelope(
          getAfter(/databases/$(database)/documents/beta_public_catalog/establishments_basic/items/$(itemId)).data,
          itemId
        );
    }
    function catalogProjectionAfterMatches(collection, itemId) {
      let projectionPath = /databases/$(database)/documents/beta_public_catalog/$(collection)/items/$(itemId);
      let projection = getAfter(projectionPath).data;
      return existsAfter(projectionPath) &&
        projection is map && projection.visibility == 'public' &&
        projection.sourceId == itemId && projection.updatedAt == request.time;
    }
    function premiumProjectionAfterMatches(itemId) {
      let premiumPath = /databases/$(database)/documents/beta_public_catalog/establishments_premium/items/$(itemId);
      let sourcePath = /databases/$(database)/documents/establishments/$(itemId);
      let premium = getAfter(premiumPath).data;
      let source = getAfter(sourcePath).data;
      return existsAfter(premiumPath) &&
        premium is map && premium.visibility == 'public' && premium.sourceId == itemId &&
        premium.schemaVersion == 1 && premium.listingTier == 'premium' &&
        premium.premiumUntil == source.premiumUntil && premium.updatedAt == request.time &&
        premiumEntitlementIsCurrent(source) &&
        basicProjectionAfterMatches(itemId);
    }
    function premiumProjectionIsSynchronized(itemId) {
      let premiumPath = /databases/$(database)/documents/beta_public_catalog/establishments_premium/items/$(itemId);
      let sourcePath = /databases/$(database)/documents/establishments/$(itemId);
      let source = getAfter(sourcePath).data;
      return premiumEntitlementIsCurrent(source) ? premiumProjectionAfterMatches(itemId) : !existsAfter(premiumPath);
    }
    function projectionIsSynchronized(collection, itemId) {
      let projectionPath = /databases/$(database)/documents/beta_public_catalog/$(collection == 'establishments' ? 'establishments_basic' : collection)/items/$(itemId);
      return collection == 'establishments'
        ? (visibleCanonicalAfter(collection, itemId)
            ? basicProjectionAfterMatches(itemId)
            : !existsAfter(projectionPath)) && premiumProjectionIsSynchronized(itemId)
        : (visibleCanonicalAfter(collection, itemId)
            ? catalogProjectionAfterMatches(collection, itemId)
            : !existsAfter(projectionPath));
    }
    function projectionsAreRemovedAfter(collection, itemId) {
      let projectionCollection = collection == 'establishments'
        ? 'establishments_basic' : collection;
      let projectionPath = /databases/$(database)/documents/beta_public_catalog/$(projectionCollection)/items/$(itemId);
      let premiumPath = /databases/$(database)/documents/beta_public_catalog/establishments_premium/items/$(itemId);
      return !existsAfter(projectionPath) &&
        (collection != 'establishments' || !existsAfter(premiumPath));
    }
    function validProjectedAdTargetAfter(data) {
      let businessId = data.get('businessId', '');
      let businessPath = /databases/$(database)/documents/establishments/$(businessId);
      let business = getAfter(businessPath).data;
      return businessId is string && businessId.size() > 0 && businessId.size() <= 128 &&
        !businessId.matches('.*[/].*') && businessId != '.' && businessId != '..' &&
        existsAfter(businessPath) && business is map &&
        business.get('published', true) == true && business.get('active', true) == true &&
        business.get('deleted', false) == false &&
        (!business.keys().hasAny(['deletedAt']) || business.deletedAt == null);
    }
    function safeBasicProjectionData(data) {
      return data is map && data.keys().hasOnly([
          'name', 'title', 'address', 'location', 'phone', 'category',
          'subcategory', 'order', 'featured'
        ]) && (data.keys().hasAny(['name']) || data.keys().hasAny(['title'])) &&
        (!data.keys().hasAny(['name']) || (data.name is string && data.name.size() <= 160)) &&
        (!data.keys().hasAny(['title']) || (data.title is string && data.title.size() <= 160)) &&
        (!data.keys().hasAny(['address']) || (data.address is string && data.address.size() <= 500)) &&
        (!data.keys().hasAny(['location']) || (data.location is string && data.location.size() <= 500)) &&
        (!data.keys().hasAny(['phone']) || (data.phone is string && data.phone.size() <= 80)) &&
        (!data.keys().hasAny(['category']) || (data.category is string && data.category.size() <= 100)) &&
        (!data.keys().hasAny(['subcategory']) || (data.subcategory is string && data.subcategory.size() <= 100)) &&
        (!data.keys().hasAny(['order']) || (data.order is int && data.order >= 0 && data.order <= 100000)) &&
        (!data.keys().hasAny(['featured']) || data.featured is bool);
    }
    function validBasicProjectionEnvelope(data, itemId) {
      return data is map && data.keys().hasOnly([
          'visibility', 'sourceId', 'schemaVersion', 'updatedAt', 'createdAt', 'publicData'
        ]) && data.keys().hasAll([
          'visibility', 'sourceId', 'schemaVersion', 'updatedAt', 'publicData'
        ]) && data.visibility == 'public' && data.sourceId == itemId &&
        data.schemaVersion == 1 && data.updatedAt is timestamp &&
        (!data.keys().hasAny(['createdAt']) || data.createdAt is timestamp) &&
        safeBasicProjectionData(data.publicData);
    }
    function safeCatalogProjectionData(data, collection) {
      return data is map && data.keys().hasOnly([
          'name', 'title', 'category', 'subcategory', 'description',
          'shortDescription', 'location', 'address', 'iconKey', 'imageUrl',
          'logoUrl', 'maps', 'mapsUrl', 'phone', 'whatsapp', 'instagram',
          'type', 'eventDate', 'endDate', 'date', 'startsAt', 'startTime',
          'endTime', 'organizer', 'registrationUrl', 'contactUrl', 'link',
          'destinationType', 'destination', 'businessId', 'promotionTitle',
          'promotionDescription', 'hours', 'additionalInfo', 'galleryUrls',
          'videoUrls', 'services', 'products', 'artwork', 'order', 'featured',
          'open', 'options'
        ]) && (data.keys().hasAny(['name']) || data.keys().hasAny(['title'])) &&
        data.keys().hasAny(['businessId']) == (collection == 'ads') &&
        (!data.keys().hasAny(['name']) || (data.name is string && data.name.size() <= 160)) &&
        (!data.keys().hasAny(['title']) || (data.title is string && data.title.size() <= 160)) &&
        (!data.keys().hasAny(['description']) || (data.description is string && data.description.size() <= 4000)) &&
        (!data.keys().hasAny(['shortDescription']) || (data.shortDescription is string && data.shortDescription.size() <= 1000)) &&
        (!data.keys().hasAny(['category']) || (data.category is string && data.category.size() <= 100)) &&
        (!data.keys().hasAny(['subcategory']) || (data.subcategory is string && data.subcategory.size() <= 100)) &&
        (!data.keys().hasAny(['location']) || (data.location is string && data.location.size() <= 500)) &&
        (!data.keys().hasAny(['address']) || (data.address is string && data.address.size() <= 500)) &&
        (!data.keys().hasAny(['imageUrl']) || (data.imageUrl is string && data.imageUrl.size() <= 2048)) &&
        (!data.keys().hasAny(['logoUrl']) || (data.logoUrl is string && data.logoUrl.size() <= 2048)) &&
        (!data.keys().hasAny(['businessId']) || (data.businessId is string && data.businessId.size() > 0 && data.businessId.size() <= 128)) &&
        (!data.keys().hasAny(['galleryUrls']) || (data.galleryUrls is list && data.galleryUrls.size() <= 20)) &&
        (!data.keys().hasAny(['videoUrls']) || (data.videoUrls is list && data.videoUrls.size() <= 20)) &&
        (!data.keys().hasAny(['services']) || (data.services is list && data.services.size() <= 40)) &&
        (!data.keys().hasAny(['products']) || (data.products is list && data.products.size() <= 40)) &&
        (!data.keys().hasAny(['options']) || (data.options is list && data.options.size() <= 20)) &&
        (!data.keys().hasAny(['artwork']) || (data.artwork is int && data.artwork >= 0 && data.artwork <= 100000)) &&
        (!data.keys().hasAny(['order']) || (data.order is int && data.order >= 0 && data.order <= 100000)) &&
        (!data.keys().hasAny(['featured']) || data.featured is bool) &&
        (!data.keys().hasAny(['open']) || data.open is bool);
    }
    function validCatalogProjectionEnvelope(data, collection, itemId) {
      return data is map && data.keys().hasOnly([
          'visibility', 'sourceId', 'schemaVersion', 'updatedAt', 'publicData'
        ]) && data.keys().hasAll([
          'visibility', 'sourceId', 'schemaVersion', 'updatedAt', 'publicData'
        ]) && data.visibility == 'public' && data.sourceId == itemId &&
        data.schemaVersion == 1 && data.updatedAt is timestamp &&
        safeCatalogProjectionData(data.publicData, collection);
    }
    function premiumEntitlementIsCurrent(source) {
      return source is map && source.get('published', false) == true &&
        source.get('active', false) == true && source.get('deleted', false) == false &&
        (!source.keys().hasAny(['deletedAt']) || source.deletedAt == null) &&
        source.get('listingTier', 'basic') == 'premium' &&
        source.get('premiumUntil', null) is timestamp && source.premiumUntil > request.time;
    }
    function safePremiumProjectionData(data) {
      return data is map && data.keys().hasOnly([
          'description', 'shortDescription', 'iconKey', 'imageUrl', 'logoUrl',
          'maps', 'mapsUrl', 'whatsapp', 'instagram', 'type', 'contactUrl',
          'link', 'hours', 'additionalInfo', 'galleryUrls', 'videoUrls',
          'services', 'products', 'artwork', 'featured', 'open', 'options'
        ]) &&
        (!data.keys().hasAny(['description']) || (data.description is string && data.description.size() <= 4000)) &&
        (!data.keys().hasAny(['shortDescription']) || (data.shortDescription is string && data.shortDescription.size() <= 1000)) &&
        (!data.keys().hasAny(['imageUrl']) || (data.imageUrl is string && data.imageUrl.size() <= 2048)) &&
        (!data.keys().hasAny(['logoUrl']) || (data.logoUrl is string && data.logoUrl.size() <= 2048)) &&
        (!data.keys().hasAny(['galleryUrls']) || (data.galleryUrls is list && data.galleryUrls.size() <= 20)) &&
        (!data.keys().hasAny(['videoUrls']) || (data.videoUrls is list && data.videoUrls.size() <= 20)) &&
        (!data.keys().hasAny(['services']) || (data.services is list && data.services.size() <= 40)) &&
        (!data.keys().hasAny(['products']) || (data.products is list && data.products.size() <= 40)) &&
        (!data.keys().hasAny(['options']) || (data.options is list && data.options.size() <= 20)) &&
        (!data.keys().hasAny(['artwork']) || (data.artwork is int && data.artwork >= 0 && data.artwork <= 100000)) &&
        (!data.keys().hasAny(['featured']) || data.featured is bool) &&
        (!data.keys().hasAny(['open']) || data.open is bool);
    }
    function validPremiumProjectionEnvelope(data, itemId, source) {
      return data is map && data.keys().hasOnly([
          'visibility', 'sourceId', 'schemaVersion', 'updatedAt',
          'listingTier', 'premiumUntil', 'publicData'
        ]) && data.keys().hasAll([
          'visibility', 'sourceId', 'schemaVersion', 'updatedAt',
          'listingTier', 'premiumUntil', 'publicData'
        ]) && data.visibility == 'public' && data.sourceId == itemId &&
        data.schemaVersion == 1 && data.updatedAt is timestamp &&
        data.listingTier == 'premium' && data.premiumUntil is timestamp &&
        data.premiumUntil == source.premiumUntil && safePremiumProjectionData(data.publicData);
    }
    function readablePremiumProjection(data, itemId) {
      let sourcePath = /databases/$(database)/documents/establishments/$(itemId);
      let basicPath = /databases/$(database)/documents/beta_public_catalog/establishments_basic/items/$(itemId);
      let source = get(sourcePath).data;
      let basic = get(basicPath).data;
      return exists(sourcePath) && premiumEntitlementIsCurrent(source) &&
        exists(basicPath) && validBasicProjectionEnvelope(basic, itemId) &&
        validPremiumProjectionEnvelope(data, itemId, source);
    }
    function safeUserCreate(userId) {
      return isOwner(userId) &&
        request.resource.data.role == 'user' &&
        request.resource.data.keys().hasOnly(['displayName', 'email', 'photoUrl', 'role', 'createdAt', 'updatedAt']) &&
        request.resource.data.keys().hasAll(['displayName', 'email', 'photoUrl', 'role', 'createdAt', 'updatedAt']) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        sameAuthEmail() &&
        str('displayName', 120) && str('email', 180) && str('photoUrl', 2048);
    }
    function safeUserUpdate(userId) {
      return isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          resource.data.keys().hasAny(['createdAt'])
            ? ['displayName', 'email', 'photoUrl', 'updatedAt']
            : ['displayName', 'email', 'photoUrl', 'updatedAt', 'createdAt']) &&
        request.resource.data.keys().hasAll(['displayName', 'email', 'photoUrl', 'role', 'createdAt', 'updatedAt']) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.createdAt == resource.data.get('createdAt', request.time) &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt == request.time &&
        sameAuthEmail() &&
        str('displayName', 120) && str('email', 180) && str('photoUrl', 2048);
    }

    match /contact_messages/{message} {
      // Backend validates schema, derives author/date, quotas and dedup.
      allow create: if false;
      allow read, delete: if admin();
      allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
        request.resource.data.read is bool;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || admin();
      allow create: if admin() || safeUserCreate(userId);
      allow update: if admin() || safeUserUpdate(userId);
      allow delete: if admin() || isOwner(userId);

      match /favorites/{favoriteId} {
        // Favorites are private owner data. Spark clients may write only a
        // bounded, typed document below their own UID; this path cannot mutate
        // another user's records or administrative data.
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && validFavorite(favoriteId) &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.updatedAt == request.time;
        allow update: if isOwner(userId) && validFavorite(favoriteId) &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.updatedAt == request.time;
        allow delete: if isOwner(userId);
      }

      match /devices/{deviceId} {
        allow create, update: if false;
        allow delete: if admin();
        allow read: if isOwner(userId) || admin();
      }
    }

    match /metrics/{metricId} {
      allow create: if false;
      allow read, update, delete: if admin();
    }

    match /reviews/{reviewId} {
      allow create: if false;
      allow read, delete: if admin();
      allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status in ['pending', 'approved', 'rejected'];
    }

    match /business_proposals/{proposalId} {
      allow create: if false;
      allow read, delete: if admin();
      allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status in ['pending', 'approved', 'rejected'];
    }

    match /polls/{pollId}/votes/{userId} {
      allow create, update, delete: if false;
      allow read: if admin();
    }

    // Fail closed for legacy targeted/missing-recipient documents. A public
    // listing uses the local backend; direct public gets validate visibility.
    match /notifications/{notificationId} {
      allow get: if admin() || (visibleDocument('notifications') && resource.data.targetEmail == '');
      allow list: if admin();
      allow create, update: if admin() && validPublicContent() &&
        request.resource.data.keys().hasOnly([
          'title', 'description', 'link', 'published', 'active', 'expiresAt', 'updatedAt', 'targetEmail'
        ]) &&
        request.resource.data.targetEmail == '' &&
        !request.resource.data.keys().hasAny(['targetUid']);
      allow delete: if admin();
    }

    match /private_notifications/{notificationId} {
      allow read: if admin() || (signedIn() &&
        resource.data.targetUid == request.auth.uid && resource.data.published == true);
      allow create, update: if admin() && validPublicContent() &&
        request.resource.data.keys().hasOnly([
          'title', 'description', 'link', 'published', 'updatedAt', 'targetUid'
        ]) && request.resource.data.targetUid is string &&
        request.resource.data.targetUid.size() > 0 &&
        request.resource.data.targetUid.size() <= 128 &&
        !request.resource.data.targetUid.matches('.*[/].*');
      allow delete: if admin();
    }

    match /push_queue/{notificationId} {
      allow create: if admin() &&
        request.resource.data.keys().hasOnly([
          'title', 'description', 'link', 'targetEmail', 'published',
          'updatedAt', 'status', 'createdAt', 'targetUid'
        ]) &&
        request.resource.data.status == 'queued' &&
        request.resource.data.get('targetEmail', '') == '' &&
        (!request.resource.data.keys().hasAny(['targetUid']) ||
          (request.resource.data.targetUid is string &&
           request.resource.data.targetUid.size() > 0 &&
           request.resource.data.targetUid.size() <= 128 &&
           !request.resource.data.targetUid.matches('.*[/].*'))) &&
        str('title', 120) &&
        str('description', 1000) &&
        str('link', 2048) &&
        str('targetEmail', 180) &&
        str('targetUid', 128) &&
        boolField('published');
      allow read, update, delete: if admin();
    }

    match /admin_audit_logs/{logId} {
      allow create: if admin() &&
        request.resource.data.keys().hasOnly([
          'action', 'collection', 'documentId', 'label',
          'adminUid', 'adminEmail', 'createdAt'
        ]) &&
        request.resource.data.adminUid == request.auth.uid &&
        (
          request.auth.token.email == null ||
          request.resource.data.adminEmail == request.auth.token.email
        ) &&
        str('action', 80) &&
        str('collection', 80) &&
        str('documentId', 200) &&
        str('label', 200) &&
        str('adminEmail', 180);
      allow read: if admin();
      allow update, delete: if false;
    }

    // Administrative vacancy data is physically separate from public jobs.
    // It is never made public by publication or visibility fields on a job.
    match /job_private/{jobId} {
      allow read, write: if admin();
    }

    match /home_pages/{pageId} {
      allow read: if pageId == 'published' || admin();
      allow create, update, delete: if admin();
    }

    match /beta_public_catalog/{collectionId}/items/{itemId} {
      // The legacy broad establishment projection can contain Premium fields.
      // It remains Admin-only; visitors use the field-limited Basic projection.
      allow get: if admin() ||
        (collectionId == 'establishments_basic' &&
          validBasicProjectionEnvelope(resource.data, itemId) &&
          visibleCanonicalSource('establishments', itemId)) ||
        (collectionId == 'establishments_premium' &&
          readablePremiumProjection(resource.data, itemId)) ||
        (collectionId != 'establishments' &&
          collectionId != 'establishments_basic' &&
          collectionId != 'establishments_premium' &&
          publicCollection(collectionId) &&
          validCatalogProjectionEnvelope(resource.data, collectionId, itemId) &&
          visibleCanonicalSource(collectionId, itemId));
      // A list query must constrain visibility because Rules are not filters.
      // Strict schemas and canonical pairing are enforced on Admin writes;
      // Premium details use get so expiry is checked against the source.
      allow list: if admin() ||
        (collectionId == 'establishments_basic' &&
          resource.data.visibility == 'public' &&
          request.query.limit != null && request.query.limit <= 40) ||
        (collectionId != 'establishments' &&
          collectionId != 'establishments_basic' &&
          collectionId != 'establishments_premium' &&
          publicCollection(collectionId) &&
          resource.data.visibility == 'public' &&
          request.query.limit != null && request.query.limit <= 40);
      // Admin writes must be paired atomically with a visible canonical source.
      // Ordinary clients cannot create, edit, or remove projections.
      allow create, update: if admin() &&
        collectionId == 'establishments_basic' &&
        validBasicProjectionEnvelope(request.resource.data, itemId) &&
        visibleCanonicalAfter('establishments', itemId) ||
        admin() && collectionId == 'establishments_premium' &&
          validPremiumProjectionEnvelope(
            request.resource.data, itemId,
            getAfter(/databases/$(database)/documents/establishments/$(itemId)).data
          ) &&
          premiumEntitlementIsCurrent(
            getAfter(/databases/$(database)/documents/establishments/$(itemId)).data
          ) &&
          existsAfter(/databases/$(database)/documents/beta_public_catalog/establishments_basic/items/$(itemId)) &&
          validBasicProjectionEnvelope(
            getAfter(/databases/$(database)/documents/beta_public_catalog/establishments_basic/items/$(itemId)).data,
            itemId
          ) ||
        admin() && collectionId != 'establishments' &&
          collectionId != 'establishments_basic' &&
          collectionId != 'establishments_premium' && publicCollection(collectionId) &&
          validCatalogProjectionEnvelope(request.resource.data, collectionId, itemId) &&
          visibleCanonicalAfter(collectionId, itemId) &&
          (collectionId != 'ads' || validProjectedAdTargetAfter(request.resource.data.publicData));
      allow delete: if admin() && collectionId == 'establishments_basic' &&
          canonicalAfterIsUnavailable('establishments', itemId) ||
        admin() && collectionId == 'establishments_premium' &&
          (canonicalAfterIsUnavailable('establishments', itemId) ||
            canonicalAfterIsVisibleBasic(itemId)) ||
        admin() && collectionId != 'establishments' &&
          collectionId != 'establishments_basic' &&
          collectionId != 'establishments_premium' && publicCollection(collectionId) &&
          canonicalAfterIsUnavailable(collectionId, itemId);
    }

    match /{collection}/{document} {
      allow get: if publicCollection(collection) &&
        (admin() || (collection != 'jobs' && collection != 'establishments' && visibleDocument(collection)));
      allow list: if publicCollection(collection) && admin();
      allow create, update: if admin() && publicCollection(collection) &&
        validPublicContent() && validAdBusinessDestination(collection) &&
        projectionIsSynchronized(collection, document);
      allow delete: if admin() && publicCollection(collection) &&
        projectionsAreRemovedAfter(collection, document);
    }
  }
}
